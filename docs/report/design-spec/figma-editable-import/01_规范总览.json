g SC"}, {"x": 64, "y": 118, "text": "AutoClaw 基础设计规范", "size": 32, "color": "#333333", "weight": 600, "font": "PingFang SC"}, {"x": 64, "y": 152, "text": "为后续界面延展建立同一套布局、视觉参数与组件语言。", "size": 14, "color": "#777777", "weight": 400, "font": "PingFang SC"}, {"x": 64, "y": 1050, "text": "V10 · 2026-10-12  |  基于基础设计规范 V09 · 浅色桌面工作区", "size": 12, "color": "#999999", "weight": 400, "font": "PingFang SC"}, {"x": 1250, "y": 1050, "text": "01 / 07", "size": 12, "color": "#777777", "weight": 400, "font": "PingFang SC"}, {"x": 114, "y": 296, "text": "任务", "size": 12, "color": "#333333", "weight": 400, "font": "PingFang SC"}, {"x": 88, "y": 339, "text": "新建任务", "size": 12, "color": "#333333", "weight": 400, "font": "PingFang SC"}, {"x": 88, "y": 376, "text": "Skill & 连接器", "size": 12, "color": "#333333", "weight": 400, "font": "PingFang SC"}, {"x": 88, "y": 440, "text": "项目", "size": 11, "color": "#999999", "weight": 400, "font": "PingFang SC"}, {"x": 88, "y": 476, "text": "任务", "size": 11, "color": "#999999", "weight": 400, "font": "PingFang SC"}, {"x": 88, "y": 512, "text": "矢量界面设计", "size": 12, "color": "#333333", "weight": 400, "font": "PingFang SC"}, {"x": 410, "y": 353, "text": "和 AutoClaw 一起工作", "size": 22, "color": "#333333", "weight": 400, "font": "PingFang SC"}, {"x": 439, "y": 396, "text": "日常办公", "size": 10, "color": "#333333", "weight": 400, "font": "PingFang SC"}, {"x": 514, "y": 396, "text": "代码开发", "size": 10, "color": "#333333", "weight": 400, "font": "PingFang SC"}, {"x": 584, "y": 396, "text": "法律助手", "size": 10, "color": "#333333", "weight": 400, "font": "PingFang SC"}, {"x": 653, "y": 396, "text": "金融分析", "size": 10, "color": "#333333", "weight": 400, "font": "PingFang SC"}, {"x": 344, "y": 445, "text": "输入“/”使用技能", "size": 11, "color": "#999999", "weight": 400, "font": "PingFang SC"}, {"x": 374, "y": 495, "text": "默认权限", "size": 10, "color": "#999999", "weight": 400, "font": "PingFang SC"}, {"x": 451, "y": 495, "text": "Agent 集群", "size": 10, "color": "#999999", "weight": 400, "font": "PingFang SC"}, {"x": 493, "y": 581, "text": "内容由 AI 生成，请核实关键信息", "size": 9, "color": "#999999", "weight": 400, "font": "PingFang SC"}, {"x": 960, "y": 245, "text": "视觉原则", "size": 20, "color": "#333333", "weight": 600, "font": "PingFang SC"}, {"x": 960, "y": 292, "text": "浅灰侧栏 + 白色工作区", "size": 16, "color": "#777777", "weight": 400, "font": "PingFang SC"}, {"x": 960, "y": 335, "text": "留白优先，内容优先", "size": 16, "color": "#777777", "weight": 400, "font": "PingFang SC"}, {"x": 960, "y": 378, "text": "灰阶区分层级，克制使用强调色", "size": 16, "color": "#777777", "weight": 400, "font": "PingFang SC"}, {"x": 960, "y": 421, "text": "输入框轻悬浮，列表保持平面", "size": 16, "color": "#777777", "weight": 400, "font": "PingFang SC"}, {"x": 960, "y": 495, "text": "延展方式", "size": 20, "color": "#333333", "weight": 600, "font": "PingFang SC"}, {"x": 960, "y": 539, "text": "沿用外壳与组件外观", "size": 15, "color": "#777777", "weight": 400, "font": "PingFang SC"}, {"x": 960, "y": 569, "text": "改变内容与区域组合", "size": 15, "color": "#777777", "weight": 400, "font": "PingFang SC"}, {"x": 960, "y": 599, "text": "新组件先复用现有参数", "size": 15, "color": "#777777", "weight": 400, "font": "PingFang SC"}, {"x": 100, "y": 722, "text": "Figma 结构", "size": 11, "color": "#1677FF", "weight": 400, "font": "PingFang SC"}, {"x": 88, "y": 774, "text": "已确认", "size": 20, "color": "#333333", "weight": 600, "font": "PingFang SC"}, {"x": 88, "y": 815, "text": "1512×945 画板、280px 侧栏", "size": 14, "color": "#777777", "weight": 400, "font": "PingFang SC"}, {"x": 88, "y": 840, "text": "部分组件尺寸与图标命名", "size": 14, "color": "#777777", "weight": 400, "font": "PingFang SC"}, {"x": 548, "y": 722, "text": "V08 样稿", "size": 11, "color": "#1677FF", "weight": 400, "font": "PingFang SC"}, {"x": 536, "y": 774, "text": "当前执行值", "size": 20, "color": "#333333", "weight": 600, "font": "PingFang SC"}, {"x": 536, "y": 815, "text": "颜色、字体、圆角与柔和阴影", "size": 14, "color": "#777777", "weight": 400, "font": "PingFang SC"}, {"x": 536, "y": 840, "text": "作为后续设计的执行基线", "size": 14, "color": "#777777", "weight": 400, "font": "PingFang SC"}, {"x": 996, "y": 722, "text": "新增场景", "size": 11, "color": "#1677FF", "weight": 400, "font": "PingFang SC"}, {"x": 984, "y": 774, "text": "扩展建议", "size": 20, "color": "#333333", "weight": 600, "font": "PingFang SC"}, {"x": 984, "y": 815, "text": "Hover / Focus / 响应布局", "size": 14, "color": "#777777", "weight": 400, "font": "PingFang SC"}, {"x": 984, "y": 840, "text": "按场景验证后再纳入规范", "size": 14, "color": "#777777", "weight": 400, "font": "PingFang SC"}, {"x": 64, "y": 970, "text": "依据：Figma 330:782 + V08 界面样稿 + 本机 AutoClaw 2.0.1 原始图标；本规范不是官方发布的设计系统。", "size": 13, "color": "#777777", "weight": 400, "font": "PingFang SC"}]}